{
  "name": "vfx-freelancer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run test:export",
    "preview": "wrangler pages dev out --config wrangler.local.jsonc --ip 127.0.0.1 --port 3000",
    "art:generate": "node scripts/generate-art.mjs",
    "test:export": "node --test scripts/export.test.mjs",
    "preview:static": "node scripts/serve.mjs",
    "db:migrate:local": "wrangler d1 migrations apply vfx-studio --local --config wrangler.local.jsonc",
    "admin:password": "node scripts/hash-password.mjs",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/postcss": "^4.1.18",
    "gsap": "^3.14.2",
    "lottie-web": "^5.13.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
